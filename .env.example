APP_SECRET_KEY=replace-with-a-long-random-secret
LOCAL_LLM_DATA_DIR=.data
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.3
OLLAMA_THINKING=true
OLLAMA_NUM_CTX=auto
APP_HOST=127.0.0.1
APP_PORT=8080
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=50
MAX_DOCX_CHARS=200000
FILE_RETENTION_MINUTES=30
MAX_CONCURRENT_JOBS=2
ACTIVE_USER_WINDOW_SECONDS=300

# Optional one-time account bootstrap. Existing accounts are never overwritten.
# Keep these values out of source control and use strong unique passwords.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-admin-password
# USER_USERNAME=user
# USER_PASSWORD=replace-with-a-strong-user-password
